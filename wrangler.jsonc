{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibebase-saas",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "src/worker.js",
  "d1_databases": [
    {
      "binding": "EVIDENCE_DB",
      "database_name": "vibebase-evidence",
      "database_id": "78bdcc9e-7cc2-4dfc-9eb9-28d0d4c77bed",
      "migrations_dir": "migrations"
    }
  ]
}
