{
  "name": "vibebase-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/validate.mjs && node scripts/release.mjs",
